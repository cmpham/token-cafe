#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
/ {
    sensors: sensors {
        compatible="zmk,keymap-sensors";
        sensors=<&encoder_1>;
        triggers-per-rotation=<20>;
    };
    via_matrix: via_matrix {
        compatible="zmk,via-matrix";
        rows=<3>; columns=<3>; map=<0 1 2 3 4 5 6 7 8>;
    };
    behaviors {
        via_encoder: via_encoder {
            compatible="zmk,via-encoder";
            #binding-cells=<1>; #sensor-binding-cells=<2>;
        };
        via_macro: via_macro { compatible="zmk,via-macro"; #binding-cells=<1>; };
        via_compat: via_compat { compatible="zmk,via-compat"; #binding-cells=<2>; };
        via_mmv: via_mouse_move {
            compatible="zmk,behavior-input-two-axis"; #binding-cells=<1>;
            x-input-code=<INPUT_REL_X>; y-input-code=<INPUT_REL_Y>;
            time-to-max-speed-ms=<300>; acceleration-exponent=<1>;
        };
    };
    keymap {
        compatible="zmk,keymap";
        default_layer {
            display-name="Cafe";
            bindings=<&kp ESC &kp SPACE &kp F13
                      &kp BSPC &kp UP &kp ENTER
                      &kp LEFT &kp DOWN &kp RIGHT>;
            /* VIA encoder parameters are QMK codes, not ZMK HID usages. */
            sensor-bindings=<&via_encoder 0x00aa 0x00a9>;
        };
        function_layer {
            display-name="Settings";
            bindings=<&none &none &to 0
                      &none &kp C_MUTE &bt BT_NXT
                      &sys_reset &bootloader &bt BT_CLR>;
            /* VIA encoder parameters are QMK codes, not ZMK HID usages. */
            sensor-bindings=<&via_encoder 0x00aa 0x00a9>;
        };
    };
};
